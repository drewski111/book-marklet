javascript:(function(){var PID='bkt-panel',DID='bkt-dark',CID='bkt-chill',PROT=/(mystical|chroma|legendary|epic|unique)/i,HLBL='✨ Highlight dupes',MLBL='🔇 Mute',ACLBL='🖱%EF%B8%8F Autoclicker',CLBL='⏳ Reset clock',KLBL='🧮 Pack odds';var PACKS=[['Medieval',20,4.5,0.25,0.009,0.0009],['Space',20,4.5,0.25,0.009,0.0009],['Aquatic',20,4.5,0.25,0.009,0.0009],['Safari',20,4.5,0.25,0.009,0.0009],['Wonderland',25,5,0.3,0.011,0.0011],['Bot',25,3.8,0.2,0.008,0.0008],['Breakfast',20,4.5,0.25,0.009,0.0009]];var TIERS=[{k:'rare',n:'Rare',c:'#4aa3ff'},{k:'epic',n:'Epic',c:'#b07aff'},{k:'legendary',n:'Legendary',c:'#e8b339'},{k:'chroma',n:'Chroma',c:'#4de3c0'}];var TORD=['common','uncommon','rare','epic','legendary','chroma'],SOLDN={rare:2,epic:3,legendary:4,chroma:5,all:6};var DK='html{filter:invert(1) hue-rotate(180deg);background:#fff !important}img,video,canvas,[style*="background-image"]{filter:invert(1) hue-rotate(180deg) !important}#bkt-panel,#bkt-clock,#bkt-modal{filter:invert(1) hue-rotate(180deg) !important}';var CH='*,*::before,*::after{animation-duration:.001s !important;animation-iteration-count:1 !important;animation-delay:0s !important;transition-duration:0s !important;transition-delay:0s !important}';function mk(i,c){var s=document.createElement('style');s.id=i;s.textContent=c;document.documentElement.appendChild(s);}function tg(i,c,b){var e=document.getElementById(i);if(e){e.remove();b.classList.remove('on');}else{mk(i,c);b.classList.add('on');}}function btxt(el){return (el.textContent||'').trim();}function hlOn(){return !!document.querySelector('.bkt-hl-sell,.bkt-hl-prot');}function clearHl(){var a=document.querySelectorAll('.bkt-hl-sell,.bkt-hl-prot');for(var i=0;i<a.length;i++)a[i].classList.remove('bkt-hl-sell','bkt-hl-prot');}function doHl(){clearHl();var seen=new Map(),n=0,all=document.querySelectorAll('span,div');for(var i=0;i<all.length;i++){var el=all[i];if(el.children.length)continue;var m=/^[x×]\s*(\d+)$/i.exec(btxt(el));if(!m)continue;var c=parseInt(m[1],