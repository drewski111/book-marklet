assList.remove('on');b.textContent=ACLBL;}}else{acOn();if(b){b.classList.add('on');b.textContent='🖱%EF%B8%8F Autoclicker ON';}}}function clkOn(){window.__bktClock=1;if(document.getElementById('bkt-clock'))return;var c=document.createElement('div');c.id='bkt-clock';c.title='Daily limit resets 00:00 UTC — click to hide';function upd(){var n=new Date(),nx=new Date(Date.UTC(n.getUTCFullYear(),n.getUTCMonth(),n.getUTCDate()+1)),ms=nx-n,h=Math.floor(ms/36e5),m=Math.floor(ms6e5/6e4),s=Math.floor(msn4/1e3);c.textContent='⏳ '+(h?h+'h ':'')+m+'m '+(s<10?'0':'')+s+'s';}document.body.appendChild(c);upd();window.__bktClkT=setInterval(upd,1000);c.onclick=function(){clkOff();var b=document.getElementById('bkt-b-clk');if(b)b.classList.remove('on');};}function clkOff(){window.__bktClock=0;if(window.__bktClkT){clearInterval(window.__bktClkT);window.__bktClkT=0;}var c=document.getElementById('bkt-clock');if(c)c.remove();}function escR(s){return String(s).replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}function calcOn(){var old=document.getElementById('bkt-modal');if(old)old.remove();var w=document.createElement('div');w.id='bkt-modal';var h='<div id="bkt-mc"><div id="bkt-mh"><span>🧮 Pack odds</span><span id="bkt-mx" style="cursor:pointer;opacity:.7">✕</span></div><div id="bkt-tabs"><button class="bkt-tab on" data-t="1">📊 By pack</button><button class="bkt-tab" data-t="2">🔍 Find a blook</button><button class="bkt-tab" data-t="3">💰 Resell</button></div><div id="bkt-mb"><div id="bkt-tab1"><div id="bkt-live" title="Click to re-fetch">🔄 loading live rates…</div><div style="display:flex;gap:8px;align-items:center;margin-bottom:10px"><span>💰 Coins</span><input id="bkt-coins" type="number" min="0" placeholder="e.g. 500" style="max-width:120px"></div><div id="bkt-packs">';PACKS.forEach(function(pk){h+='<div class="bkt-pk" data-name="'+pk[0]+'" data-price="'+pk[1]+'"><div class="bkt-pkh"><span class="bkt-nm">'+pk[0]+'</span><span>'+pk[1]+'🪙</span><span class="bkt-bx">–</span></div>';TIERS.forEach(function(t,i){h+='<div class="bkt-tier"><span class="bkt-tl" style="color:'+t.c+'">'+t.n+'</span><input class="bkt-rate" data-tier="'+t.k+'" type="number" step="any" min="0" max="100" value="'+pk[2+i]+'"><span class="bkt-pv">–</span><span class="bkt-ev">–</span><div class="bkt-bar"><i style="width:0%;background:'+t.c+'"></i></div></div>';});h+='</div>';});h+='</div><div id="bkt-stats">Enter coins to see odds.</div></div><div id="bkt-tab2" style="display:none"><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px"><select id="bkt-fpack" class="bkt-rate" style="max-width:160px">';PACKS.forEach(function(pk){h+='<option value="'+pk[0]+' Pack" data-price="'+pk[1]+'">'+pk[0]+' ('+pk[1]+'🪙)</option>';});h+='</select><input id="bkt-fname" class="bkt-rate" style="max-width:160px" placeholder="blook name, e.g. Dragon"><button class="bkt-btn bkt-gray" id="bkt-ffetch">Fetch %</button></div><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:6px"><span>Chance/box %</span><input id="bkt-frate" class="bkt-rate" type="number" step="any" min="0" max="100" placeholder="0.02" style="max-width:90px"><span>Confidence</span><select id="bkt-ftarget" class="bkt-rate" style="max-width:90px"><option value="0.5">50%</option><option value="0.75">75%</option><option value="0.9" selected>90%</option><option value="0.95">95%</option><option value="0.99">99%</option></select></div><div id="bkt-fstatus" style="font-size:11px;color:#8b8fa3;margin-bottom:4px">Uses the blook\u2019s own per-box %.</div><div id="bkt-fout">Type a blook name → Fetch % → see boxes & coins needed.</div></div><div id="bkt-tab3" style="display:none"><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px"><span>💰 Coins</span><input id="bkt-rcoins" class="bkt-rate" type="number" min="0" placeholder="e.g. 500" style="max-width:100px"><span>Keep</span><select id="bkt-rkeep" class="bkt-rate" style="max-width:170px"><option value="rare">Rare+ (sell c/u)</option><option value="epic" selected>Epic+ (sell c/u/rare)</option><option value="legendary">Legendary+</option><option value="chroma">Chroma+</option><option value="all">nothing — sell all</option></select></div><div style="font-size:11px;color:#8b8fa3;margin:2px 0 4px">Sell values 🪙 (editable):</div><div class="bkt-svrow"><label class="bkt-svl">Common<input class="bkt-rate bkt-sv" data-v="common" type="number" step="any" min="0" value="5"></label><label class="bkt-svl">Uncommon<input class="bkt-rate bkt-sv" data-v="uncommon" type="number" step="any" min="0" value="10"></label><label class="bkt-svl">Rare<input class="bkt-rate bkt-sv" data-v="rare" type="number" step="any" min="0" value="20"></label><label class="bkt-svl">Epic<input class="bkt-rate bkt-sv" data-v="epic" type="number" step="any" min="0" value="75"></label><label class="bkt-svl">Legendary<input class="bkt-rate bkt-sv" data-v="legendary" type="number" step="any" min="0" value="200"></label><label class="bkt-svl">Chroma<input class="bkt-rate bkt-sv" data-v="chroma" type="number" step="any" min="0" value="250"></label></div><div class="bkt-rh"><span>Pack</span><span title="Common chance %">C%</span><span title="Uncommon chance %">U%</span><span>Refund</span><span>Net/box</span><span>Net tot</span></div><div id="bkt-rlist">';PACKS.forEach(function(pk){h+='<div class="bkt-res" data-name="'+pk[0]+'" data-price="'+pk[1]+'"><span class="bkt-rnm">'+pk[0]+'</span><input class="bkt-rate bkt-rc" type="number" step="any" min="0" max="100" value="45" title="Common chance %"><input class="bkt-rate bkt-ru" type="number" step="any" min="0" max="100" value="50" title="Uncommon chance %"><span class="bkt-rf">–</span><span class="bkt-rn">–</span><span class="bkt-rt">–</span></div>';});h+='</div><div id="bkt-rstats" style="margin-top:8px;font-size:12px;color:#8b8fa3"></div></div></div></div><div id="bkt-mf"><span>P(≥1)=1−(1−p)ⁿ · refund = Σ chance×value</span><button class="bkt-btn bkt-gray" id="bkt-kc">Close</button></div></div>';w.innerHTML=h;document.body.appendChild(w);w.querySelector('#bkt-mx').onclick=function(){w.remove();};w.querySelector('#bkt-kc').onclick=function(){w.remove();};[].slice.call(w.querySelectorAll('.bkt-tab')).forEach(function(t){t.onclick=function(){[].slice.call(w.querySelectorAll('.bkt-tab')).forEach(function(x){x.classList.toggle('on',x===t);});['1','2','3'].forEach(function(n){w.querySelector('#bkt-tab'+n).style.display=t.dataset.t===n?'':'none';});};});var packsBox=w.querySelector('#bkt-packs'),coins=w.querySelector('#bkt-coins');function render(){var X=parseFloat(coins.value)||0;var blocks=[].slice.call(packsBox.querySelectorAll('.bkt-pk'));blocks.forEach(function(b){var price=+b.dataset.price,n=Math.floor(X/price);b.dataset.n=n;b.dataset.pr=0;b.dataset.pl=0;b.dataset.pc=0;b.querySelector('.bkt-bx').textContent=n<1?'×0':'×'+n;[].slice.call(b.querySelectorAll('.bkt-tier')).forEach(function(tr){var inp=tr.querySelector('.bkt-rate');var p=parseFloat(inp.value);if(!(p>0))p=0;if(p>99.9)p=99.9;var prob=(n<1||!p)?0:(1-Math.pow(1-p/100,n))*100;var pv=tr.querySelector('.bkt-pv'),ev=tr.querySelector('.bkt-ev');pv.textContent=prob<=0?'–':(prob<0.01?'<0.01%':prob.toFixed(prob<10?2:1)+'%');pv.style.color=prob>50?'#7fd39a':prob>5?'#e8b339':'#f2f2f2';ev.textContent=p>0?'~1/'+Math.round(100/p).toLocaleString():'–';tr.querySelector('.bkt-bar i').style.width=Math.min(100,Math.sqrt(prob)*10)+'%';var tier=inp.dataset.tier;if(tier==='rare')b.dataset.pr=prob;if(tier==='legendary')b.dataset.pl=prob;if(tier==='chroma')b.dataset.pc=prob;});});var f=document.getElementById('bkt-stats');var cand=blocks.filter(function(b){return +b.dataset.n>=1;});if(!cand.length){f.innerHTML='Not enough coins for any box yet.';return;}blocks.forEach(function(b){b.querySelector('.bkt-nm').textContent=b.dataset.name;});function mx(key){return cand.reduce(function(a,b){return +b[key]>+a[key]?b:a;},cand[0]);}var br=mx('pr'),bl=mx('pl'),bc=mx('pc');br.querySelector('.bkt-nm').textContent='👑 '+br.dataset.name;if(bl!==br)bl.querySelector('.bkt-nm').textContent='🏆 '+bl.dataset.name;var lrate=parseFloat(bl.querySelector('.bkt-rate[data-tier="legendary"]').value)||0;f.innerHTML='<b style="color:#e8b339">'+bl.dataset.name+'</b> leads for Legendaries: '+bl.dataset.n+' boxes → <b>'+(+bl.dataset.pl<0.01?'&lt;0.01':(+bl.dataset.pl).toFixed(2))+'%</b>'+(lrate>0?' (about 1 in '+Math.round(100/lrate).toLocaleString()+' boxes)':'')+'. Chroma leader: <b style="color:#4de3c0">'+bc.dataset.name+'</b>. Bar scale is √-compressed.';}coins.addEventListener('input',render);function renderResell(){var X=parseFloat(w.querySelector('#bkt-rcoins').value)||0;var keep=w.querySelector('#bkt-rkeep').value;var sv={};[].slice.call(w.querySelectorAll('.bkt-sv')).forEach(function(i){var v=parseFloat(i.value);sv[i.dataset.v]=v>0?v:0;});var rows=[].slice.call(w.querySelectorAll('.bkt-res'));var best=null,bestNet=1e9;rows.forEach(function(r){var price=+r.dataset.price;function tRate(tier){var el=packsBox.querySelector('.bkt-pk[data-name="'+r.dataset.name+'"] .bkt-rate[data-tier="'+tier+'"]');var v=el?parseFloat(el.value):0;return v>0?v:0;}var rates={common:parseFloat(r.querySelector('.bkt-rc').value)||0,uncommon:parseFloat(r.querySelector('.bkt-ru').value)||0,rare:tRate('rare'),epic:tRate('epic'),legendary:tRate('legendary'),chroma:tRate('chroma')};var sold=TORD.slice(0,SOLDN[keep]||6);var refund=0,evall=0;TORD.forEach(function(t){var c=rates[t]*sv[t]/100;evall+=c;if(sold.indexOf(t)>=0)refund+=c;});var net=price-refund;var boxes=X>0?Math.floor(X/price):0;r.querySelector('.bkt-rf').textContent=refund.toFixed(2)+'🪙';var rn=r.querySelector('.bkt-rn');rn.textContent=net.toFixed(2)+'🪙';rn.style.color=net<=0?'#7fd39a':'#f2f2f2';r.querySelector('.bkt-rt').textContent=boxes>0?(boxes*net).toFixed(0)+'🪙':'–';r.dataset.evall=evall.toFixed(2);r.classList.remove('bkt-best2');r.querySelector('.bkt-rnm').textContent=r.dataset.name;if(net<bestNet){bestNet=net;best=r;}});var st=w.querySelector('#bkt-rstats');if(st&&best){best.classList.add('bkt-best2');best.querySelector('.bkt-rnm').textContent='👑 '+best.dataset.name;var price=+best.dataset.price,refund=price-bestNet,disc=price>0?Math.round(refund/price*100):0;st.innerHTML='👑 <b style="color:#e8b339">'+best.dataset.name+'</b>: reselling dupes refunds ~'+refund.toFixed(2)+'🪙/box ('+disc+'% off) → effective <b>'+bestNet.toFixed(2)+'🪙/box</b>. Full-sell value of one box: '+best.dataset.evall+'🪙 — always below the pack price, so reselling discounts the hunt, it doesn\u2019t print coins.';}}[].slice.call(packsBox.querySelectorAll('.bkt-rate')).forEach(function(inp){inp.addEventListener('input',function(){render();renderResell();});});w.querySelector('#bkt-rcoins').addEventListener('input',renderResell);w.querySelector('#bkt-rkeep').addEventListener('change',renderResell);[].slice.call(w.querySelectorAll('.bkt-sv,.bkt-rc,.bkt-ru')).forEach(function(i){i.addEventListener('input',renderResell);});function parseTier(wt,tier){var re=new RegExp('\\b'+tier+'\\b[^\\n%]{0,140}?(\\d+(?:\\.\\d+)?)\\s*(%?)','i');var m=re.exec(wt);if(!m)return 0;var v=parseFloat(m[1]);if(isNaN(v))return 0;if(m[2]==='%')return v;return v<=1?v*100:v;}function fetchLive(){var st=document.getElementById('bkt-live');if(!st)return;st.textContent='🔄 fetching live rates…';fetch('https://blooket.fandom.com/api.php?action=query&format=json&origin=*&prop=revisions&rvprop=content&redirects=1&titles='+encodeURIComponent(PACKS.map(function(p){return p[0]+' Pack';}).join('|'))).then(function(r){return r.json();}).then(function(j){var got=0,pages=(j.query||{}).pages||{};Object.keys(pages).forEach(function(k){var pg=pages[k];if(!pg||!pg.revisions)return;var wt=((pg.revisions[0]||{})['*'])||'';var nm=(pg.title||'').replace(/\s*pack\s*$/i,'');var b=null;[].slice.call(packsBox.querySelectorAll('.bkt-pk')).forEach(function(x){if(x.dataset.name.toLowerCase()===nm.toLowerCase())b=x;});if(b){TIERS.forEach(function(t){var v=parseTier(wt,t.k);if(v>0){b.querySelector('.bkt-rate[d